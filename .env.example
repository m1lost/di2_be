# Application
APP_NAME=di2
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Authentication
JWT_SECRET=your_jwt_secret
EMAIL_TOKEN_SECRET=your_email_token_secret

# Frontend
FRONTEND_URL=http://localhost:5173

# MailerSend
MAILERSEND_API_TOKEN=your_mailersend_api_token
MAIL_FROM_EMAIL=your_verified_sender_email
MAIL_FROM_NAME=di2 App

#corss-origin
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https:
